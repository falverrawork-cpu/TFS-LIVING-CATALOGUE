generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql"; url = env("DATABASE_URL") }
enum Role { ADMIN EDITOR }
enum CatalogueStatus { DRAFT READY EXPORTED ARCHIVED }
enum ImportRowStatus { NEW UPDATE WARNING ERROR UNCHANGED }
model User { id String @id @default(cuid()); email String @unique; name String?; role Role @default(EDITOR); createdAt DateTime @default(now()); updatedAt DateTime @updatedAt }
model Brand { id String @id @default(cuid()); name String; logoUrl String?; primaryColor String @default("#f45124"); secondaryColor String @default("#ffffff"); textColor String @default("#171717"); catalogueFooter String?; defaultYear Int?; aboutTitle String?; aboutDescription String? @db.Text; aboutImageUrl String?; legalName String?; address String? @db.Text; collaborationEmail String?; collaborationPhone String?; bulkEmail String?; bulkPhone String?; serviceEmail String?; servicePhone String?; backCoverImageUrl String?; catalogues Catalogue[]; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt }
model Collection { id String @id @default(cuid()); name String; slug String @unique; displayOrder Int @default(0); description String? @db.Text; imageUrl String?; isActive Boolean @default(true); archivedAt DateTime?; products Product[]; catalogueLinks CatalogueCollection[]; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt }
model Product { id String @id @default(cuid()); productCode String @unique; productName String; collectionId String; collection Collection @relation(fields:[collectionId], references:[id]); price Decimal @db.Decimal(12,2); trp Decimal? @db.Decimal(12,2); lengthCm Decimal?; widthCm Decimal?; heightCm Decimal?; lengthInch Decimal?; widthInch Decimal?; heightInch Decimal?; primaryImageUrl String?; highlightImageUrl String?; displayOrder Int @default(0); isActive Boolean @default(true); isHighlighted Boolean @default(false); showInProductGrid Boolean @default(true); archivedAt DateTime?; highlights CatalogueHighlight[]; media Media[]; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; @@index([collectionId,displayOrder]) }
model Catalogue { id String @id @default(cuid()); brandId String; brand Brand @relation(fields:[brandId],references:[id]); name String; year Int; status CatalogueStatus @default(DRAFT); coverTitle String; coverSubtitle String?; coverImageUrl String?; aboutTitle String?; aboutHeading String?; aboutDescription String? @db.Text; aboutImageUrl String?; backCoverImageUrl String?; collections CatalogueCollection[]; highlights CatalogueHighlight[]; exports CatalogueExport[]; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt }
model CatalogueCollection { catalogueId String; collectionId String; displayOrder Int; enabled Boolean @default(true); catalogue Catalogue @relation(fields:[catalogueId],references:[id],onDelete:Cascade); collection Collection @relation(fields:[collectionId],references:[id]); @@id([catalogueId,collectionId]) }
model CatalogueHighlight { id String @id @default(cuid()); catalogueId String; productId String; placement String @default("END_OF_COLLECTION"); afterProductCode String?; afterGridPage Int?; textPosition String @default("BOTTOM_LEFT"); textColor String @default("#ffffff"); overlayDarkness Int @default(30); catalogue Catalogue @relation(fields:[catalogueId],references:[id],onDelete:Cascade); product Product @relation(fields:[productId],references:[id]); @@unique([catalogueId,productId]) }
model CatalogueExport { id String @id @default(cuid()); catalogueId String; catalogue Catalogue @relation(fields:[catalogueId],references:[id]); manifest Json; pdfUrl String?; productCount Int; pageCount Int; collectionCount Int; quality String @default("HIGH"); createdAt DateTime @default(now()) }
model ExcelImport { id String @id @default(cuid()); fileName String; rowCount Int; createdCount Int @default(0); updatedCount Int @default(0); failedCount Int @default(0); rows ExcelImportRow[]; createdAt DateTime @default(now()) }
model ExcelImportRow { id String @id @default(cuid()); importId String; import ExcelImport @relation(fields:[importId],references:[id],onDelete:Cascade); rowNumber Int; productCode String?; status ImportRowStatus; payload Json; errors Json? }
model Media { id String @id @default(cuid()); productId String?; product Product? @relation(fields:[productId],references:[id]); fileName String; url String; mimeType String; width Int?; height Int?; sizeBytes Int; createdAt DateTime @default(now()) }
