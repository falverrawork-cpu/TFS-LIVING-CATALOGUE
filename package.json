{
  "name": "tfs-living-catalogue-workspace",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter ./frontend --filter ./backend dev",
    "dev:frontend": "pnpm --dir frontend dev",
    "dev:backend": "pnpm --dir backend dev",
    "build": "npm --prefix frontend run build:sites",
    "test": "pnpm --recursive test",
    "typecheck": "pnpm --recursive typecheck",
    "hosting:check": "pnpm --dir frontend build"
  }
}
